{
  "name": "@muditor/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate --generator client",
    "push": "prisma db push --skip-generate && bun run generate",
    "studio": "prisma studio",
    "migrate:dev": "prisma migrate dev && bun run generate",
    "migrate:reset": "prisma migrate reset && bun run generate",
    "migrate:deploy": "prisma migrate deploy && bun run generate",
    "seed": "bun src/seed/index.ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf src/generated"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "pg": "^8.16.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.0",
    "@graphql-codegen/client-preset": "^5.0.0",
    "@graphql-codegen/typescript": "^5.0.0",
    "@graphql-codegen/typescript-operations": "^5.0.0",
    "@graphql-codegen/typescript-react-apollo": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.9.2",
    "dotenv": "^17.2.2",
    "husky": "^9.1.7",
    "@types/pg": "^8.15.4",
    "prisma": "^7.0.0",
    "typescript": "6.0.0-beta"
  }
}
