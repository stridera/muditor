# Development Environment Configuration
# Copy this to .env for local development

# Database Configuration
DATABASE_URL="postgresql://strider@localhost:5432/fierydev"
DATABASE_URL_TEST="postgresql://strider@localhost:5432/muditor_test"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="dev-jwt-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# API Configuration
API_PORT=3001
API_HOST="localhost"
GRAPHQL_PLAYGROUND=true
GRAPHQL_DEBUG=true
CORS_ORIGIN="https://muditor.utaboshi.com"

# Web Application Configuration
NEXTAUTH_URL="https://muditor.utaboshi.com"
NEXTAUTH_SECRET="dev-nextauth-secret-change-in-production"

# Environment
NODE_ENV="development"
ENVIRONMENT="development"

# Logging
LOG_LEVEL="debug"

# Security (relaxed for development)
BCRYPT_ROUNDS=8
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=900000

# FieryMUD Admin API
FIERYMUD_ADMIN_URL="http://localhost:8080"
FIERYMUD_ADMIN_TOKEN="nBq/4wYoV7Twa/QuhCHtRoLbkdx42PKlhcZZeBbDaNE="

# Google OAuth (set real values in .env.development.local)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://muditor-api.utaboshi.com/api/auth/google/callback"

# Development Features
ENABLE_SCRIPT_SANDBOX=true
ENABLE_REAL_TIME=true
ENABLE_FILE_UPLOAD=true
ENABLE_DEBUG_ROUTES=true